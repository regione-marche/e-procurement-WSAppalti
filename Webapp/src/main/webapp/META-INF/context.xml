<?xml version='1.0' encoding='utf-8'?>
<Context>

	<Resource name="jdbc/${nomeWebapp}" 
		auth="Container" 
		type="javax.sql.DataSource" 
		driverClassName=""
		url="" 
		username="" 
		password="" 
		defaultAutoCommit="false"
		maxTotal="20" 
		maxIdle="10" />

	<!-- Parametri (facoltativi) per la gestione tramite bucket -->
	
	<!-- Attiva il caricamento dei file su bucket.
	     Se abilitata, allora i successivi parametri sono tutti obbligatori, se disabilitata allora i successivi sono necessari se serve leggere i file gia' caricati su bucket -->
	<Environment name="objectStorage.enable" value="${objectStorage.enable}" type="java.lang.Boolean" override="false" />
	
	<!-- url del microservizio objectstorage-ms per lo storage su bucket -->
	<Environment name="objectStorage.url" value="${objectStorage.url}" type="java.lang.String" override="false" />
	
	<!-- tenant id associato al cliente -->
	<Environment name="objectStorage.tenantId" value="${objectStorage.tenantId}" type="java.lang.String" override="false" />



